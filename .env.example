# ---------------------------------------------------------------------------
# Greenware ERP — environment template.  Copy to `.env` and fill in.
#
#   cp .env.example .env && ${EDITOR:-vi} .env
#
# NEVER commit `.env`. Every value below is a placeholder, not a real secret.
# Variable names match api/src/core/config.ts exactly — nothing here is invented.
# ---------------------------------------------------------------------------

# ---- Postgres (the `postgres` service in docker-compose.yml) ---------------
POSTGRES_DB=greenware
POSTGRES_USER=postgres
# Generate one:  openssl rand -base64 24
POSTGRES_PASSWORD=change-me-before-first-boot

# ---- Host port mappings (compose only; change if these clash locally) -----
# 5433 is deliberate: api/src/__tests__/env.ts defaults DATABASE_URL to :5433,
# so the test suite runs against a compose stack with no extra configuration.
POSTGRES_HOST_PORT=5433
# 8080 is deliberate: api/src/__tests__/helpers.ts defaults API_URL to :8080.
API_HOST_PORT=8080
# The browser URL. The web container proxies /api to the api container, because
# web/src/lib/api.ts calls `/api/v1/...` relatively and has no base-URL setting.
WEB_HOST_PORT=8081

# ---- API ------------------------------------------------------------------
# NOTE: docker-compose.yml does NOT read this value — it builds the URL from
# POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB above so the two can never
# drift apart. This variable is for everything else: running the API outside
# compose, applying migrations with infra/scripts/apply-migrations.sh, and
# pointing at DigitalOcean Managed Postgres (private URI, `?sslmode=require`).
DATABASE_URL=postgres://postgres:change-me-before-first-boot@127.0.0.1:5433/greenware

# Generate one:  openssl rand -hex 32
# config.ts falls back to 'dev-only-secret-change-me' if this is unset — that
# fallback must never reach a deployed environment.
JWT_SECRET=change-me-openssl-rand-hex-32
JWT_TTL=8h

NODE_ENV=production
PORT=8080
HOST=0.0.0.0

# ---- Business configuration (OD decisions; see docs/CONVENTIONS.md) -------
COMPANY_CODE=GWT
# OD-18: the Dubai calendar governs every SLA clock, Trichy included.
DEFAULT_CALENDAR=Dubai
# OD-09: hard floor. Warn thresholds live per business type in gw.margin_rules.
MARGIN_FLOOR_PCT=3

# ---- Generated-document store --------------------------------------------
# api/src/modules/documents.ts writes generated PDFs/HTML to this directory on
# the LOCAL FILESYSTEM. In compose this is a named volume. On App Platform the
# container filesystem is ephemeral and these files are lost on every deploy —
# see "What is NOT production-ready yet" in docs/DEPLOYMENT.md.
DOCUMENT_STORE_DIR=/app/storage

# ---- Entra ID / Microsoft 365 SSO ----------------------------------------
# Leave disabled until the Entra app registration exists. Local password login
# (gw.settings `auth.local.*`) is the only working path while this is false.
ENTRA_ENABLED=false
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=

# ---- Seed / test fixtures -------------------------------------------------
# `demo` switches on the `seed` service in docker-compose.yml, so a plain
# `docker compose up` produces a stack you can actually log in to.
# REMOVE `demo` FROM THIS LINE before this stack holds any real data — the seed
# inserts the whole Greenware staff list with one shared password.
COMPOSE_PROFILES=demo

# Password given to every seeded demo user by api/src/db/seed.ts. Development
# and CI only. Never run the seed against a real environment.
SEED_PASSWORD=Greenware#2026
